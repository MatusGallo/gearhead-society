---
import Mark from "../assets/mark.svg";

interface Props {
  class?: string;
  /** Only the hex nut harness mark, without the wordmark */
  markOnly?: boolean;
}
const { class: cls = "", markOnly = false } = Astro.props;
---

<!-- Hex nut with a harness (crossed straps, O-ring); takes the text colour (acid by default) -->
<span class:list={["inline-flex items-center gap-3", cls]}>
  <Mark class="shrink-0 text-acid" width={markOnly ? 40 : 44} height={markOnly ? 40 : 44} aria-hidden="true" />
  {
    !markOnly && (
      <span class="display text-[0.95rem] !leading-[1] tracking-normal">
        Gearhead
        <br />
        <span class="text-acid">Society</span>
      </span>
    )
  }
</span>
