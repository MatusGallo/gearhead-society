---
import { Image } from "astro:assets";
import emblem from "../assets/brand/emblem.png";
import mark from "../assets/brand/mark.png";

interface Props {
  class?: string;
  /** Only the gas-mask head, for tight spots like the header */
  markOnly?: boolean;
}
const { class: cls = "", markOnly = false } = Astro.props;
---

<!-- Operator in a cog: the full emblem carries the wordmark, the head alone is the small mark -->
{
  markOnly ? (
    <Image src={mark} alt="" width={44} height={44} densities={[1, 2, 3]} class:list={["size-11 shrink-0", cls]} />
  ) : (
    <Image src={emblem} alt="Gearhead Society" width={112} densities={[1, 2, 3]} class:list={["h-auto w-28 shrink-0", cls]} />
  )
}
