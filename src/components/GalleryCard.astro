---
import Icon from "./Icon.astro";
import ScanField from "./ScanField.astro";
import Visual from "./Visual.astro";
import { galleryCover, type Gallery } from "../data/galleries";
import { href, ui, type Lang } from "../i18n";

interface Props {
  gallery: Gallery;
  lang: Lang;
  class?: string;
  /** Aspect ratio class for the cover */
  aspect?: string;
  /** Inside a horizontal strip the cover drifts with the swipe */
  strip?: boolean;
  /** Position in a grid; picks the hover gesture so neighbours never share one */
  index?: number;
}
const { gallery, lang, class: cls = "", aspect = "aspect-[4/5]", strip = false, index = 0 } = Astro.props;
const cover = galleryCover(gallery);
const kindIcon = { photos: "camera", wall: "image", shoot: "users-three", film: "film-strip" }[gallery.kind];
// Hover gestures on top of the shared base (tone, brackets, acid bar): frame slice, scan line,
// target lock, film shutter, survey grid, acid wipe
const effects = ["glitch", "scan", "target", "shutter", "grid", "wipe"] as const;
const fx = effects[index % effects.length];
---

<a href={href(lang, `/galleries/${gallery.slug}`)} class:list={["group flex flex-col", `hv-${fx}`, cls]}>
  <div class="frame flex flex-1 flex-col">
    <div class="relative overflow-hidden">
      <div class="fx-cover">
        {
          cover ? (
            <Visual src={cover} sizes="(min-width: 1024px) 50vw, 100vw" alt={gallery.title} tone="mono" hover={fx === "glitch" ? "glitch" : "tone"} fx={["dots"]} imgClass={strip ? "drift" : "settle"} class={aspect} />
          ) : (
            <ScanField seed={gallery.hue} animate={false} labels={[]} tilt={false} class={aspect} />
          )
        }
      </div>
      {fx === "scan" && <span class="fx-layer fx-line" aria-hidden="true" />}
      {
        fx === "target" && (
          <span class="fx-layer fx-reticle" aria-hidden="true">
            <span class="fx-cross" />
            <span class="fx-box" />
          </span>
        )
      }
      {
        fx === "shutter" && (
          <>
            <span class="fx-layer fx-bar fx-bar-top" aria-hidden="true" />
            <span class="fx-layer fx-bar fx-bar-bottom" aria-hidden="true" />
          </>
        )
      }
      {fx === "grid" && <span class="fx-layer fx-grid" aria-hidden="true" />}
      {fx === "wipe" && <span class="fx-layer fx-block" aria-hidden="true" />}
      <span class="chip absolute top-0 left-0 z-10"><Icon name={kindIcon} class="size-3.5" /> {ui.galleryKind[gallery.kind][lang]}</span>
    </div>
    <div class="flex flex-1 items-center justify-between gap-3 bg-steel px-4 py-4 transition-colors group-hover:bg-acid group-hover:text-ink">
      <h3 class="mono text-sm">{gallery.title}</h3>
      <Icon name="plus" class="size-5 shrink-0 transition-transform duration-500 ease-(--ease-out-expo) motion-safe:group-hover:rotate-90" />
    </div>
  </div>
</a>

<style>
  .fx-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
  }
  .group:focus-visible .fx-layer {
    opacity: 1;
  }
  /* Hover effects only for real pointers: a tap on touch would leave them stuck on */
  @media (hover: hover) and (pointer: fine) {
    .group:hover .fx-layer { opacity: 1; }
    .hv-shutter:hover .fx-bar { transform: scaleY(1); }
  }

  /* Scan: an acid line with a trail runs down the photo */
  .fx-line {
    background: linear-gradient(to bottom, transparent 70%, color-mix(in oklab, var(--color-acid) 22%, transparent) 97%, var(--color-acid) 98.6%, transparent 100%);
    transform: translateY(-100%);
  }

  /* Target: crosshair and a reticle box lock onto the centre */
  .fx-cross {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(var(--color-acid), var(--color-acid)) 50% 0 / 1px 100% no-repeat,
      linear-gradient(var(--color-acid), var(--color-acid)) 0 50% / 100% 1px no-repeat;
    opacity: 0.6;
  }
  .fx-box {
    position: absolute;
    inset: 32%;
    --c: var(--color-acid);
    background:
      linear-gradient(var(--c), var(--c)) 0 0 / 14px 2px no-repeat,
      linear-gradient(var(--c), var(--c)) 0 0 / 2px 14px no-repeat,
      linear-gradient(var(--c), var(--c)) 100% 0 / 14px 2px no-repeat,
      linear-gradient(var(--c), var(--c)) 100% 0 / 2px 14px no-repeat,
      linear-gradient(var(--c), var(--c)) 0 100% / 14px 2px no-repeat,
      linear-gradient(var(--c), var(--c)) 0 100% / 2px 14px no-repeat,
      linear-gradient(var(--c), var(--c)) 100% 100% / 14px 2px no-repeat,
      linear-gradient(var(--c), var(--c)) 100% 100% / 2px 14px no-repeat;
  }
  .fx-box::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 6px;
    height: 6px;
    translate: -50% -50%;
    background: var(--color-acid);
  }

  /* Shutter: letterbox bars close in, the photo pushes in */
  .fx-bar {
    inset: auto 0;
    height: 13%;
    background: var(--color-ink);
    opacity: 1;
    transform: scaleY(0);
  }
  .fx-bar-top { top: 0; transform-origin: 50% 0; }
  .fx-bar-bottom { bottom: 0; transform-origin: 50% 100%; }
  .hv-shutter:focus-visible .fx-bar { transform: scaleY(1); }

  /* Grid: a survey grid settles over the photo */
  .fx-grid {
    background:
      repeating-linear-gradient(to right, color-mix(in oklab, var(--color-acid) 45%, transparent) 0 1px, transparent 1px 12.5%),
      repeating-linear-gradient(to bottom, color-mix(in oklab, var(--color-acid) 45%, transparent) 0 1px, transparent 1px 10%);
  }

  /* Wipe: an acid block crosses the photo once */
  .fx-block {
    background: var(--color-acid);
    transform: translateX(-101%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .fx-layer { transition: opacity 0.3s; }
    /* Hovered often while browsing the grid, so the zooms stay short */
    .fx-cover { transition: transform 0.45s var(--ease-out-expo); }
    .fx-reticle { transform: scale(1.35); transition: opacity 0.25s, transform 0.4s var(--ease-out-expo); }
    .fx-bar { transition: transform 0.4s var(--ease-out-expo); }
    .fx-grid { transform: scale(1.12); transition: opacity 0.3s, transform 0.5s var(--ease-out-expo); }
  }
  @media (prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine) {
    .hv-scan:hover .fx-line { animation: fx-scan 1.1s var(--ease-out-expo) both; }
    .hv-target:hover .fx-reticle { transform: none; }
    .hv-target:hover .fx-cover { transform: scale(1.06); }
    .hv-shutter:hover .fx-cover { transform: scale(1.08); }
    .group:hover .fx-grid { transform: none; }
    .hv-wipe:hover .fx-block { animation: fx-wipe 0.75s cubic-bezier(0.7, 0, 0.3, 1) both; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fx-block,
    .fx-line { display: none; }
  }
  @keyframes fx-scan {
    from { transform: translateY(-100%); }
    to { transform: translateY(100%); }
  }
  @keyframes fx-wipe {
    0% { transform: translateX(-101%); }
    45%, 55% { transform: translateX(0); }
    100% { transform: translateX(101%); }
  }
</style>
