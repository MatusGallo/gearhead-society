---
/**
 * Feeds pointer position into CSS for hero effects, measured on every `[data-pointer]` element:
 *   --x / --y    pointer in px inside the element (peek lens)
 *   --px / --py  pointer from -1 to 1 around the centre (depth, map steering)
 * The vars are written only onto the descendants that read them (`[data-pointer-vars]`), not onto
 * the hero itself: custom properties inherit, so setting them on the root restyled the whole hero
 * every frame. With no marked descendant the root gets them, as before.
 * `data-active` is set while the pointer is inside. Fine pointers only; one rAF per frame.
 */
---

<script>
  if (matchMedia("(pointer: fine)").matches) {
    document.querySelectorAll<HTMLElement>("[data-pointer]").forEach((el) => {
      const marked = [...el.querySelectorAll<HTMLElement>("[data-pointer-vars]")];
      const targets = marked.length ? marked : [el];
      const set = (name: string, value: string) => targets.forEach((t) => t.style.setProperty(name, value));
      let raf = 0;
      let last: PointerEvent | null = null;
      const apply = () => {
        raf = 0;
        if (!last) return;
        const r = el.getBoundingClientRect();
        const x = last.clientX - r.left;
        const y = last.clientY - r.top;
        set("--x", `${x}px`);
        set("--y", `${y}px`);
        set("--px", ((x / r.width) * 2 - 1).toFixed(3));
        set("--py", ((y / r.height) * 2 - 1).toFixed(3));
      };
      el.addEventListener("pointermove", (e) => {
        last = e;
        raf ||= requestAnimationFrame(apply);
      });
      el.addEventListener("pointerenter", () => el.setAttribute("data-active", ""));
      el.addEventListener("pointerleave", () => {
        el.removeAttribute("data-active");
        set("--px", "0");
        set("--py", "0");
      });
    });
  }
</script>
