---
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import { nav, site } from "../data/site";
import { upcomingEditions } from "../data/sommers";
import { href, langName, langs, stripLang, switchLang, ui, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  /** On Sommers pages the CTA is the single Sommers ticket, not the Gearhead ticket tiers */
  theme?: "sommers";
}
const { lang, theme } = Astro.props;
const nextSommers = upcomingEditions()[0];
const cta =
  theme === "sommers"
    ? { label: ui.ticket[lang], href: nextSommers ? `${href(lang, `/sommers/${nextSommers.slug}`)}#vstupenka` : href(lang, "/sommers") }
    : { label: ui.tickets[lang], href: href(lang, site.ticketsPath) };
const path = Astro.url.pathname;
const bare = stripLang(path);
const isActive = (p: string) => bare === p || bare.startsWith(p + "/");
const sommersAccent = "#a98bff";
---

<header class="fixed inset-x-0 top-0 z-50 flex h-15 border-b border-line bg-ink">
  <a href={href(lang)} class="grid shrink-0 place-items-center border-r border-line px-3 transition-opacity hover:opacity-80" aria-label={`${site.name}, ${ui.home[lang]}`}>
    <Logo markOnly />
  </a>

  <nav class="hidden flex-1 items-center gap-5 px-6 whitespace-nowrap lg:flex xl:gap-7 xl:px-7" aria-label="Main">
    {
      nav.map((item) => (
        <a
          href={href(lang, item.path)}
          class:list={["mono text-sm transition-colors hover:text-acid", isActive(item.path) ? "text-acid" : "text-bone/75"]}
          aria-current={isActive(item.path) ? "page" : undefined}
          style={item.sommers && !isActive(item.path) ? `color:${sommersAccent}` : undefined}
        >
          {item.label[lang]}
        </a>
      ))
    }
  </nav>

  <div class="ml-auto flex">
    <div class="mono flex items-center border-l border-line px-2 text-xs" aria-label={ui.language[lang]} role="group">
      {
        langs.map((l) => (
          <a
            href={switchLang(path, l)}
            hreflang={l}
            lang={l}
            title={langName[l]}
            class:list={["grid size-11 place-items-center transition-colors", l === lang ? "text-acid" : "text-bone/60 hover:text-bone"]}
            aria-current={l === lang ? "true" : undefined}
          >
            {l.toUpperCase()}
          </a>
        ))
      }
    </div>

    <div class="hidden items-center gap-1 border-l border-line px-3 xl:flex">
      {
        site.socials.map((s) => (
          <a href={s.href} target="_blank" rel="noopener" class="grid size-11 place-items-center text-bone/75 transition-colors hover:text-acid" aria-label={s.label}>
            <Icon name={s.icon} class="size-5" />
          </a>
        ))
      }
    </div>
  </div>

  <a href={cta.href} class="mono hidden h-full items-center justify-center bg-acid px-10 text-sm text-ink transition-colors hover:bg-bone md:flex xl:w-80">
    {cta.label}
  </a>

  <button
    id="menu-toggle"
    class="grid w-15 place-items-center border-l border-line lg:hidden"
    aria-label={ui.openMenu[lang]}
    aria-expanded="false"
    aria-controls="mobile-menu"
    data-open={ui.openMenu[lang]}
    data-close={ui.closeMenu[lang]}
  >
    <Icon name="list" class="size-6" />
  </button>

  <div id="mobile-menu" class="fixed inset-x-0 top-15 bottom-0 hidden overflow-y-auto bg-ink lg:hidden">
    <nav class="flex flex-col px-4 py-6" aria-label="Mobile">
      {
        nav.map((item) => (
          <a
            href={href(lang, item.path)}
            class:list={["display border-b border-line py-5 text-3xl", isActive(item.path) && "text-acid"]}
            style={item.sommers && !isActive(item.path) ? `color:${sommersAccent}` : undefined}
          >
            {item.label[lang]}
          </a>
        ))
      }
      <a href={cta.href} class="btn btn-acid mt-6">{cta.label}</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle")!;
  const menu = document.getElementById("mobile-menu")!;

  menu.hidden = true;
  menu.classList.remove("hidden");

  toggle.addEventListener("click", () => {
    const open = menu.hidden;
    menu.hidden = !open;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", (open ? toggle.dataset.close : toggle.dataset.open) || "");
    document.body.style.overflow = open ? "hidden" : "";
  });
</script>
