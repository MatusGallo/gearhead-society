---
interface Props {
  title: string;
  lead?: string;
}
const { title, lead } = Astro.props;
---

<section class="relative overflow-hidden pt-15">
  <div class="relative mx-auto max-w-[1400px] px-4 pt-16 pb-14 sm:px-6 sm:pt-20 md:min-h-[26rem]">
    <h1 class="title-in display text-[clamp(2.75rem,8vw,6rem)]">{title}</h1>
    <span class="rule-draw mt-8 block h-px w-full max-w-md bg-acid" aria-hidden="true"></span>
    {lead && <p class="title-in mt-7 max-w-[60ch] text-lg leading-relaxed text-bone/75" style="--i:3">{lead}</p>}
    <slot />
  </div>
</section>
