---
import Layout from "../../../layouts/Layout.astro";
import Countdown from "../../../components/Countdown.astro";
import ContentRail from "../../../components/ContentRail.astro";
import Icon from "../../../components/Icon.astro";
import SommersPoster from "../../../components/SommersPoster.astro";
import EditionMark from "../../../components/EditionMark.astro";
import { editionLabel, formatRange, sommers, upcomingEditions, type SommersEdition } from "../../../data/sommers";
import { href, langs, translator, ui, type Lang } from "../../../i18n";

export function getStaticPaths() {
  return langs.flatMap((lang) => upcomingEditions().map((edition) => ({ params: { lang, slug: edition.slug }, props: { edition } })));
}

const lang = Astro.params.lang as Lang;
const t = translator(lang);
const { edition: e } = Astro.props as { edition: SommersEdition };
const label = editionLabel(e, lang);
const register = t({ cs: "Registrace", en: "Register" });
const mailto = `mailto:${sommers.email}?subject=${encodeURIComponent(`${register}: ${label}${e.number ? "" : ` ${e.title[lang]}`}`)}`;

// Sidebar facts, grouped into two short chunks instead of one long table
const clean = (rows: [string, string | undefined][]) => rows.filter(([, v]) => v) as [string, string][];
const factGroups = [
  {
    title: t({ cs: "Termín a místo", en: "When and where" }),
    rows: clean([
      [t({ cs: "Datum", en: "Dates" }), formatRange(e.start, e.end, lang)],
      [t({ cs: "Místo", en: "Place" }), e.place[lang]],
      [ui.ticket[lang], e.price?.[lang]],
      [t({ cs: "Kapacita", en: "Capacity" }), e.capacity?.[lang]],
    ]),
  },
  {
    title: t({ cs: "Tým", en: "Team" }),
    rows: clean([
      [t({ cs: "Organizátor", en: "Organiser" }), e.team?.organizer[lang]],
      [t({ cs: "Koordinátor", en: "Coordinator" }), e.team?.coordinator],
      [t({ cs: "Fotograf", en: "Photographer" }), e.team?.photographer],
    ]),
  },
].filter((g) => g.rows.length);

// Content blocks in reading order
const sections = [
  e.kind === "sraz" && { id: "bezpecnost", title: t({ cs: "Bezpečnost", en: "Safety" }), list: sommers.safety[lang] },
  e.kind === "sraz" && { id: "registrace", title: register, list: sommers.registration[lang] },
  e.accommodation && { id: "ubytovani", title: t({ cs: "Ubytování", en: "Accommodation" }), paras: e.accommodation[lang] },
].filter(Boolean) as { id: string; title: string; list?: string[]; paras?: string[] }[];

const timeRe = /^(\d{1,2}:\d{2}(?:\s*-\s*\d{1,2}:\d{2})?)\s+(.*)$/;
// Programme days run from the start date, one block per day
const dayDate = (i: number) => {
  const d = new Date(`${e.start}T12:00:00Z`);
  d.setUTCDate(d.getUTCDate() + i);
  return `${String(d.getUTCDate()).padStart(2, "0")}.${String(d.getUTCMonth() + 1).padStart(2, "0")}.`;
};
---

<Layout lang={lang} theme="sommers" title={`${label}: ${e.title[lang]}`} description={e.summary[lang]}>
  <!-- HERO: the poster and the countdown -->
  <section class="pt-15">
    <div class="mx-auto grid max-w-[1400px] items-end gap-12 px-4 pt-16 pb-14 sm:px-6 lg:grid-cols-[1.15fr_1fr]">
      <div class="hero-in">
        <div style="--i:1"><EditionMark edition={e} lang={lang} class="text-[clamp(2.5rem,5vw,3.5rem)]" /></div>
        <h1 class="display mt-6 text-[clamp(2.25rem,6vw,4.75rem)] text-balance" style="--i:1">{e.title[lang]}</h1>
        <p class="mono mt-5 text-sm text-bone/85" style="--i:2">
          {formatRange(e.start, e.end, lang)}, {e.place[lang]}
        </p>
        <div class="mt-8 flex flex-col gap-6 sm:flex-row sm:items-center" style="--i:3">
          <Countdown target={`${e.start}T15:00:00+02:00`} labels={ui.countdown[lang]} />
          <a href={mailto} class="btn btn-acid self-start sm:self-auto">{register} <Icon name="envelope-simple" /></a>
        </div>
      </div>
      <div class="frame frame-on">
        <SommersPoster edition={e} lang={lang} />
      </div>
    </div>
  </section>

  <!-- CONTENT -->
  <section class="relative mx-auto grid max-w-[1400px] gap-14 px-4 py-20 sm:px-6 lg:grid-cols-[1fr_22rem] lg:pl-24">
    <ContentRail label={e.title[lang]} numbers={[e.number ? String(e.number) : e.start.slice(8, 10), e.start.slice(2, 4)]} lines={[e.title[lang], e.place[lang]]} />
    <article class="min-w-0 space-y-14">
      <a href={href(lang, "/sommers")} class="inline-flex min-h-11 items-center gap-2 text-sm text-mute hover:text-acid">
        <Icon name="arrow-left" /> {t({ cs: "Všechny edice Sommers", en: "All Sommers editions" })}
      </a>

      <div class="max-w-[65ch] space-y-4 leading-relaxed text-bone/80">
        {
          e.kind === "sraz" ? (
            <>
              <p class="text-xl text-bone">
                {t({ cs: "Sraz se koná o víkendu", en: "The meetup takes place on the weekend of" })}{" "}
                <span class="text-acid">{formatRange(e.start, e.end, lang)}</span>. {t({ cs: "Místo konání", en: "Place" })}: {e.place[lang]}.
              </p>
              <p>{sommers.readFirst[lang]}</p>
              {sommers.intro[lang].map((p) => <p>{p}</p>)}
            </>
          ) : (
            e.body?.[lang].map((p) => <p>{p}</p>)
          )
        }
      </div>

      {
        sections.map((s) => (
          <div id={s.id} class="scroll-mt-24 border-t border-line pt-10">
            <h2 class="display mb-5 text-2xl sm:text-3xl">{s.title}</h2>
            {s.list && (
              <ul class="max-w-[65ch] space-y-3 leading-relaxed text-bone/80">
                {s.list.map((li) => (
                  <li class="grid grid-cols-[1.25rem_1fr] gap-2">
                    <Icon name="plus" class="mt-1.5 size-3.5 text-acid" />
                    <span>{li}</span>
                  </li>
                ))}
              </ul>
            )}
            {s.paras && <div class="max-w-[65ch] space-y-3 leading-relaxed text-bone/80">{s.paras.map((p) => <p>{p}</p>)}</div>}
          </div>
        ))
      }

      {
        e.menu && (
          <div id="jidelnicek" class="scroll-mt-24 border-t border-line pt-10">
            <h2 class="display text-2xl sm:text-3xl">{t({ cs: "Jídelníček", en: "Menu" })}</h2>
            {e.menuNote && <p class="mono mt-3 text-xs text-acid">{e.menuNote[lang]}</p>}
            <div class="mt-6 grid gap-px overflow-hidden border border-line bg-line sm:grid-cols-2">
              {e.menu.map((m) => (
                <div class="bg-ink p-5">
                  <h3 class="mono text-xs text-mute">{m.day[lang]}</h3>
                  <ul class="mt-2 space-y-1 text-sm text-bone/85">{m.items[lang].map((i) => <li>{i}</li>)}</ul>
                </div>
              ))}
            </div>
          </div>
        )
      }

      {
        e.schedule && (
          <div id="program" class="scroll-mt-24 border-t border-line pt-10">
            <h2 class="display text-2xl sm:text-3xl">{t({ cs: "Program", en: "Programme" })}</h2>
            <div class="mt-5 max-w-[65ch] space-y-3 leading-relaxed text-bone/80">{e.programIntro?.[lang].map((p) => <p>{p}</p>)}</div>
            <!-- Timeline: one rail per day, timed items get an accent node and their time, the rest a hollow tick -->
            <ol class="mt-10 space-y-12">
              {e.schedule.map((d, i) => (
                <li class="grid gap-5 sm:grid-cols-[9rem_1fr] sm:gap-8">
                  <div class="flex items-baseline gap-3 sm:sticky sm:top-24 sm:block sm:self-start">
                    <p class="mono text-[11px] text-mute">
                      {String(i + 1).padStart(2, "0")} / {String(e.schedule!.length).padStart(2, "0")}
                    </p>
                    <h3 class="display text-xl sm:mt-1 sm:text-2xl">{d.day[lang]}</h3>
                    <p class="mono text-xs text-acid sm:mt-1">{dayDate(i)}</p>
                  </div>
                  <ol class="trace relative">
                    {d.items[lang].map((item) => {
                      const m = item.match(timeRe);
                      return (
                        <li class="grid grid-cols-[var(--rail)_1fr] py-2">
                          <span class="mono pr-4 text-right text-xs leading-snug text-acid sm:text-sm">{m?.[1]}</span>
                          <span class:list={["relative pl-6 leading-snug", m ? "text-bone" : "text-bone/70"]}>
                            <span
                              aria-hidden="true"
                              class:list={[
                                "absolute left-0 top-[0.7em] z-[1] -translate-x-1/2 -translate-y-1/2",
                                m ? "size-2.5 bg-acid" : "size-1.5 border border-bone/40 bg-ink",
                              ]}
                            />
                            {m ? m[2] : item}
                          </span>
                        </li>
                      );
                    })}
                  </ol>
                </li>
              ))}
            </ol>
          </div>
        )
      }

      {
        e.extras?.map((x) => (
          <div class="border-t border-line pt-10">
            <h2 class="display text-2xl">{x.title[lang]}</h2>
            <p class="mt-3 max-w-[65ch] leading-relaxed text-bone/80">{x.text[lang]}</p>
          </div>
        ))
      }

      {
        e.other && (
          <div id="ostatni" class="scroll-mt-24 border-t border-line pt-10">
            <h2 class="display mb-5 text-2xl sm:text-3xl">{t({ cs: "Ostatní informace", en: "Other information" })}</h2>
            <div class="max-w-[65ch] space-y-3 leading-relaxed text-bone/80">
              {e.other[lang].map((p) => <p>{p}</p>)}
              <p>
                {t({ cs: "Doprava", en: "Transport" })}:{" "}
                <a href="https://www.seznam.cz/jizdnirady" target="_blank" rel="noopener" class="text-acid underline underline-offset-4 hover:text-bone">seznam.cz/jizdnirady</a>
              </p>
            </div>
          </div>
        )
      }

      {e.kind === "sraz" && <p class="border-t border-line pt-8 text-bone">{t({ cs: "Na tento sraz srdečně zvou a těší se na viděnou:", en: "Warmly inviting you and looking forward to seeing you:" })} {sommers.hosts}.</p>}
    </article>

    <!-- SIDEBAR -->
    <aside class="space-y-6 lg:sticky lg:top-24 lg:self-start">
      <!-- Readout panels: violet header block with its index, hairline rows -->
      <div class="frame frame-on border border-line bg-coal">
        {
          factGroups.map((g, i) => (
            <div>
              <p class="mono flex items-center justify-between bg-violet px-4 py-2 text-xs text-acid">
                <span>{g.title}</span>
                <span class="text-bone/60">{String(i + 1).padStart(2, "0")}</span>
              </p>
              <dl class="text-sm">
                {g.rows.map(([k, v]) => (
                  <div class="grid grid-cols-[7rem_1fr] gap-3 border-b border-line px-4 py-2.5 last:border-b-0">
                    <dt class="mono text-[11px] leading-5 text-mute">{k}</dt>
                    <dd>{v}</dd>
                  </div>
                ))}
              </dl>
            </div>
          ))
        }
      </div>

      <!-- One ticket per meetup, no tiers: the price covers accommodation and food -->
      <div id="vstupenka" class="frame frame-on scroll-mt-24 border border-acid p-6">
        <p class="mono text-xs text-acid">{ui.ticket[lang]}</p>
        <p class="display mt-3 text-3xl">{e.price?.[lang] ?? t({ cs: "Cena brzy", en: "Price soon" })}</p>
        <p class="mt-3 text-sm text-bone/80">
          {t({ cs: "Jedna vstupenka pro všechny, žádné typy. Platíš jen náklady na ubytování a jídlo.", en: "One ticket for everyone, no tiers. You only pay for accommodation and food." })}
        </p>
        <a href={mailto} class="btn btn-acid mt-5 w-full">{register} <Icon name="envelope-simple" /></a>
        <p class="mt-4 text-sm text-bone/80">{t({ cs: "Pouze e-mailem. Uveď svoji přezdívku pro registrační tabulku a jmenovku.", en: "By e-mail only. Include the nickname for the registration list and your name tag." })}</p>
        <a href={mailto} class="mt-2 inline-flex min-h-11 items-center gap-2 text-sm break-all text-acid underline underline-offset-4 hover:text-bone">
          <Icon name="envelope-simple" /> {sommers.email}
        </a>
      </div>

      {
        e.deadlines && (
          <div class="border border-line bg-coal">
            <p class="mono bg-violet px-4 py-2 text-xs text-acid">{t({ cs: "Důležité termíny", en: "Key dates" })}</p>
            <ul class="text-sm">
              {e.deadlines.map((d) => (
                <li class="border-b border-line px-4 py-2.5 last:border-b-0">
                  <span class="mono block text-[11px] text-mute">{d.label[lang]}</span>
                  <span>{d.value[lang]}</span>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        e.sponsors && (
          <div class="border border-line bg-coal">
            <p class="mono flex items-center justify-between bg-violet px-4 py-2 text-xs text-acid">
              <span>{t({ cs: "Sponzoři. Děkujeme!", en: "Sponsors. Thank you!" })}</span>
              <Icon name="heart" class="size-3.5" />
            </p>
            <!-- Hairline grid: the gap shows the line colour between cells -->
            <ul class="grid grid-cols-2 gap-px bg-line">
              {e.sponsors.map((s) => (
                <li class="display flex min-h-16 items-center bg-coal px-4 text-sm transition-colors duration-300 hover:bg-steel hover:text-acid">{s}</li>
              ))}
              {e.sponsors.length % 2 === 1 && <li class="bg-coal" aria-hidden="true"></li>}
            </ul>
          </div>
        )
      }
    </aside>
  </section>

</Layout>
