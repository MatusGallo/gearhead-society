---
import Layout from "../layouts/Layout.astro";
import { href } from "../i18n";

// Served for any language, so it speaks both.
---

<Layout lang="cs" title="404" noindex>
  <section class="mx-auto flex min-h-[80dvh] max-w-[1400px] flex-col justify-center px-4 pt-24 sm:px-6">
    <p class="mono text-sm text-acid">Error 404</p>
    <h1 class="display mt-4 text-[clamp(3rem,12vw,6rem)]">Ztraceno<span class="text-acid">?</span></h1>
    <p class="mt-4 max-w-md text-bone/80">Tahle stránka neexistuje nebo se přesunula.</p>
    <p lang="en" class="mt-1 max-w-md text-mute">This page does not exist or has moved.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={href("cs")} class="btn btn-acid">Domů</a>
      <a href={href("en")} class="btn btn-ghost" lang="en">Home</a>
    </div>
  </section>
</Layout>
