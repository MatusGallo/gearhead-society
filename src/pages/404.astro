---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import ScanField from "../components/ScanField.astro";
import Countdown from "../components/Countdown.astro";
import { nav } from "../data/site";
import { formatNumeric, nextEvent } from "../data/events";
import { href, langs, ui, type L } from "../i18n";

// One page serves every missing URL, so it carries both languages: an inline script picks the
// language from the path (/en/... reads English) and CSS hides the other copy (see [data-l]).
// The header and footer stay in the default language.
const pad = (n: number) => String(n).padStart(2, "0");
const next = nextEvent();
const start = next?.start;

const copy = {
  status: { cs: "Signál ztracen", en: "Signal lost" },
  title: { cs: "Mimo mapu", en: "Off the map" },
  lead: {
    cs: "Tahle stránka neexistuje, nebo se přesunula. Sken pořád hledá, ale zámek nechytí. Vrať se do známého sektoru.",
    en: "This page does not exist or has moved. The scan keeps searching but never locks. Head back to a known sector.",
  },
  path: { cs: "Cesta", en: "Path" },
  code: { cs: "Stav", en: "Status" },
  lock: { cs: "Zámek", en: "Lock" },
  none: { cs: "Žádný", en: "None" },
  home: { cs: "Zpět na základnu", en: "Back to base" },
  events: { cs: "Všechny akce", en: "All events" },
  sectors: { cs: "Známé sektory", en: "Known sectors" },
  search: { cs: "Hledám", en: "Searching" },
  noLock: { cs: "Bez zámku", en: "No lock" },
  next: { cs: "Příští akce", en: "Next event" },
  map: { cs: "Animovaná mapa terénu, zaměřovač hledá cíl a nenajde ho", en: "Animated terrain map, a reticle searching for a target it never finds" },
} satisfies Record<string, L>;
---

<Layout lang="cs" title="404" noindex>
  <script is:inline slot="head">
    if (/^\/en(\/|$)/.test(location.pathname)) document.documentElement.lang = "en";
  </script>

  <!-- HERO: a lost signal. Code and title on the left with the real requested path, on the right
       the scan map with a reticle that hunts from spot to spot and never locks -->
  <section class="nf relative overflow-hidden border-b border-line pt-15">
    <div class="mx-auto grid max-w-[1400px] gap-12 px-4 pt-14 pb-16 sm:px-6 sm:pt-20 lg:grid-cols-[minmax(0,1fr)_minmax(0,40rem)] lg:gap-16">
      <div class="flex min-w-0 flex-col">
        <div class="flex items-center justify-between gap-4">
          <p class="mono flex items-center gap-2 text-xs text-acid">
            <span class="nf-live size-1.5 bg-acid" aria-hidden="true"></span>
            {langs.map((l) => <span data-l={l}>{copy.status[l]}</span>)}
          </p>
          <div class="mono flex text-xs" role="group" aria-label={`${ui.language.cs} / ${ui.language.en}`}>
            {langs.map((l) => (
              <button type="button" class="nf-lang border border-line px-2.5 py-1.5 text-mute transition-colors hover:text-bone [&:not(:first-child)]:-ml-px" data-set-lang={l} lang={l}>{l}</button>
            ))}
          </div>
        </div>

        <p class="nf-code display mt-8 text-[clamp(6rem,22vw,15rem)] leading-[0.8] text-transparent" aria-hidden="true">404</p>
        <h1 class="title-in display mt-4 text-[clamp(2.5rem,7vw,5.5rem)]" style="--i:1">
          {langs.map((l) => <span data-l={l}>{copy.title[l]}</span>)}
        </h1>
        <p class="title-in mt-6 max-w-[46ch] text-lg leading-relaxed text-bone/75" style="--i:3">
          {langs.map((l) => <span data-l={l}>{copy.lead[l]}</span>)}
        </p>

        <div class="mt-auto pt-12">
          <span class="rule-draw block h-px w-full bg-acid" aria-hidden="true"></span>
          <dl class="hero-in mono mt-6 grid grid-cols-[minmax(0,2fr)_minmax(0,1fr)_minmax(0,1fr)] gap-4 text-[0.7rem] leading-tight">
            <div class="min-w-0 border-l border-line pl-3" style="--i:2">
              <dt class="text-mute">{langs.map((l) => <span data-l={l}>{copy.path[l]}</span>)}</dt>
              <dd class="mt-1.5 truncate text-acid normal-case" data-path>/</dd>
            </div>
            <div class="border-l border-line pl-3" style="--i:3">
              <dt class="text-mute">{langs.map((l) => <span data-l={l}>{copy.code[l]}</span>)}</dt>
              <dd class="mt-1.5 text-bone">404</dd>
            </div>
            <div class="border-l border-line pl-3" style="--i:4">
              <dt class="text-mute">{langs.map((l) => <span data-l={l}>{copy.lock[l]}</span>)}</dt>
              <dd class="mt-1.5 text-bone">{langs.map((l) => <span data-l={l}>{copy.none[l]}</span>)}</dd>
            </div>
          </dl>
          <div class="hero-in mt-8 flex flex-wrap gap-3">
            {langs.map((l) => (
              <a href={href(l)} class="btn btn-acid" data-l={l} style="--i:5">
                <Icon name="arrow-left" />{copy.home[l]}
              </a>
            ))}
            {langs.map((l) => (
              <a href={href(l, "/events")} class="btn btn-ghost" data-l={l} style="--i:6">{copy.events[l]}</a>
            ))}
          </div>
        </div>
      </div>

      <div class="relative flex min-w-0 flex-col border border-line bg-coal">
        <div class="mono flex items-center justify-between gap-4 border-b border-line px-5 py-3 text-xs">
          <span class="text-mute">SCAN / 404</span>
          <span class="nf-state text-acid">{langs.map((l) => <span data-l={l}>{copy.search[l]}</span>)}</span>
        </div>
        <div class="grid min-h-80 flex-1">
          <ScanField seed={404} labels={[]} label={copy.map.cs} pauseLabel={ui.pause.cs} playLabel={ui.play.cs} class="min-h-80">
          <!-- Reticle: flat on top of the map, transform only; it hops between spots and each
               time the brackets close in, find nothing and open again -->
          <div class="nf-hunt pointer-events-none absolute top-1/2 left-1/2" aria-hidden="true">
            <div class="nf-reticle relative -translate-1/2">
              <svg viewBox="0 0 100 100" class="nf-brackets size-28 text-acid sm:size-36" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M2 24V2h22M76 2h22v22M98 76v22H76M24 98H2V76" />
              </svg>
              <span class="absolute top-1/2 left-1/2 size-2 -translate-1/2 border border-acid"></span>
              <span class="nf-tag mono absolute top-full left-0 mt-2 bg-acid px-1.5 py-0.5 text-[0.65rem] whitespace-nowrap text-ink">
                404 / {langs.map((l) => <span data-l={l}>{copy.noLock[l]}</span>)}
              </span>
            </div>
          </div>
          </ScanField>
        </div>
        {
          next && start &&
            langs.map((l) => (
              <a href={href(l, `/events/${next.slug}`)} data-l={l} class="group mono flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t border-line px-5 py-4 text-xs transition-colors hover:bg-acid hover:text-ink">
                <span class="flex items-center gap-3">
                  <span class="text-mute transition-colors group-hover:text-ink/70">{copy.next[l]}</span>
                  <span class="text-bone transition-colors group-hover:text-ink">{next.title} / {formatNumeric(start, l)}</span>
                </span>
                <span class="flex items-center gap-3 text-acid transition-colors group-hover:text-ink">
                  T-<Countdown target={start} labels={ui.countdown[l]} compact />
                  <Icon name="arrow-right" class="size-4 transition-transform motion-safe:group-hover:translate-x-0.5" />
                </span>
              </a>
            ))
        }
      </div>
    </div>
  </section>

  <!-- KNOWN SECTORS: every main section as a numbered row, booting on like a readout -->
  <section class="mx-auto max-w-[1400px] px-4 py-20 sm:px-6">
    <h2 class="heading-in display text-[clamp(2rem,5vw,3.75rem)]">{langs.map((l) => <span data-l={l}>{copy.sectors[l]}</span>)}</h2>
    <ul class="boot-in mt-10 grid border-t border-line sm:grid-cols-2 lg:grid-cols-4">
      {nav.map((item, i) => (
        <li class="border-b border-line sm:[&:nth-child(odd)]:border-r lg:[&:not(:nth-child(4n))]:border-r" style={`--i:${i}`}>
          {langs.map((l) => (
            <a href={href(l, item.path)} data-l={l} class="nf-sector group relative flex h-full items-center justify-between gap-4 px-5 py-6">
              <span class="relative flex items-baseline gap-4">
                <span class="mono text-xs text-mute transition-colors group-hover:text-ink">SEC {pad(i + 1)}</span>
                <span class="display text-lg transition-colors group-hover:text-ink sm:text-xl">{item.label[l]}</span>
              </span>
              <Icon name="arrow-up-right" class="relative size-4 text-acid transition-[color,transform] group-hover:text-ink motion-safe:group-hover:translate-x-0.5 motion-safe:group-hover:-translate-y-0.5" />
            </a>
          ))}
        </li>
      ))}
    </ul>
  </section>
</Layout>

<script>
  // Real requested path, as text only
  const path = document.querySelector<HTMLElement>("[data-path]");
  if (path) {
    try {
      path.textContent = decodeURI(location.pathname);
    } catch {
      path.textContent = location.pathname;
    }
  }

  const setLang = (l: string) => {
    document.documentElement.lang = l;
    document.querySelectorAll<HTMLButtonElement>("[data-set-lang]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.setLang === l)));
  };
  setLang(document.documentElement.lang === "en" ? "en" : "cs");
  document.querySelectorAll<HTMLButtonElement>("[data-set-lang]").forEach((b) => b.addEventListener("click", () => setLang(b.dataset.setLang!)));
</script>

<style is:global>
  /* Only the copy in the page's language shows */
  html:not([lang="en"]) [data-l="en"],
  html[lang="en"] [data-l="cs"] {
    display: none;
  }
</style>

<style>
  .nf-code {
    -webkit-text-stroke: 1px var(--color-acid);
  }
  .nf-lang[aria-pressed="true"] {
    border-color: var(--color-acid);
    color: var(--color-acid);
    position: relative;
  }

  /* Acid fill sweeps in on hover, transform only */
  .nf-sector::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--color-acid);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s var(--ease-out-expo);
  }
  .nf-sector:focus-visible::before { transform: none; }
  @media (hover: hover) and (pointer: fine) {
    .nf-sector:hover::before { transform: none; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .nf-live { animation: nf-blink 1.2s steps(1, end) infinite; }
    .nf-code { animation: fade 1.2s var(--ease-out-expo) both; }
    /* Hops between five spots; each hold the brackets close in and open again */
    .nf-hunt { animation: nf-hop 9s steps(1, end) infinite; }
    .nf-brackets { animation: nf-close 1.8s var(--ease-out-expo) infinite; }
    .nf-tag { animation: nf-blink 0.9s steps(1, end) infinite; }
    /* The reticle stops with the map's pause button */
    :global(.scan[data-paused]) :is(.nf-hunt, .nf-brackets, .nf-tag) { animation-play-state: paused; }
  }
  @keyframes nf-blink {
    50% { opacity: 0.2; }
  }
  @keyframes nf-hop {
    0% { transform: translate(-60%, -40%); }
    20% { transform: translate(90%, 70%); }
    40% { transform: translate(-150%, 110%); }
    60% { transform: translate(120%, -120%); }
    80% { transform: translate(-30%, -150%); }
  }
  @keyframes nf-close {
    0% { transform: scale(1.35); opacity: 0.4; }
    45% { transform: scale(0.9); opacity: 1; }
    60% { transform: scale(1); }
    100% { transform: scale(1.35); opacity: 0.4; }
  }
</style>
